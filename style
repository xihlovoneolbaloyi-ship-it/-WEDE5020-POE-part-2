/*==================================================
  Sweet Crumbs Bakery
  style.css
==================================================*/

/*==================================================
CSS VARIABLES
==================================================*/

:root{
    --primary:#8B4513;
    --secondary:#D2691E;
    --accent:#C97B36;
    --background:#FFF8F2;
    --white:#ffffff;
    --text:#333333;
    --light:#FFF1E6;
    --shadow:0 8px 18px rgba(0,0,0,.12);
    --radius:15px;
    --transition:.3s ease;
}
/*==================================================
CSS Improve Body
==================================================*/

body{
    font-family:'Open Sans',sans-serif;
    background:var(--background);
    color:var(--text);
    line-height:1.7;
    font-size:16px;
}

/*==================================================
CSS Improve Typography
==================================================*/

h1,
h2,
h3,
h4{
    font-family:'Poppins',sans-serif;
    line-height:1.2;
}

img{
    display:block;
    max-width:100%;
    height:auto;
}

/*==============================
HEADER
==============================*/

header{
    background:linear-gradient(135deg,var(--primary),var(--accent));
    color:var(--white);
    text-align:center;
    padding:25px;
    box-shadow:0 4px 12px rgba(0,0,0,.25);
}

header h1{
    font-family:'Poppins',sans-serif;
    font-size:2.8rem;
    margin-bottom:10px;
}

header p{
    font-size:1.1rem;
    margin-bottom:20px;
}

/*==============================
NAVIGATION
==============================*/

nav{
    display:flex;
    justify-content:center;
    align-items:center;
    flex-wrap:wrap;
    gap:12px;
}

nav a{
    color:var(--white);
    text-decoration:none;
    padding:12px 20px;
    border-radius:30px;
    transition:var(--transition);
    font-weight:600;
}

nav a:hover,
nav a.active{
    background:var(--white);
    color:var(--primary);

/*==============================
HERO
==============================*/

.hero{
    background:url("../images/hero.jpg") center/cover no-repeat;
    min-height:520px;
    display:flex;
    align-items:center;
    justify-content:center;
    text-align:center;
    color:white;
}

.hero-content{
    background:rgba(0,0,0,.55);
    padding:45px;
    border-radius:15px;
    max-width:700px;
}

.hero h2{
    font-size:3rem;
    margin-bottom:20px;
}

.hero p{
    font-size:1.2rem;
    margin-bottom:25px;
}

/*==============================
BUTTONS
==============================*/

.btn,
button{

    display:inline-block;

    background:var(--secondary);

    color:var(--white);

    padding:14px 28px;

    border:none;

    border-radius:30px;

    text-decoration:none;

    cursor:pointer;

    transition:
        background .3s,
        transform .3s,
        box-shadow .3s;

}

.btn:hover,
button:hover{

    background:var(--primary);

    transform:translateY(-4px);

    box-shadow:0 8px 18px rgba(0,0,0,.2);

}

/*==============================
MAIN LAYOUT
==============================*/

main{
    width:min(92%,1200px);
    margin:40px auto;
}

section{
    margin-bottom:60px;
    padding:20px 0;
}

section h2{
    text-align:center;
    color:#8B4513;
    font-family:'Poppins',sans-serif;
    margin-bottom:20px;
    font-size:2rem;
}

section p{
    margin-bottom:15px;
}

/*==============================
PRODUCT CARDS
==============================*/

.product-card{

    background:white;

    border-radius:var(--radius);

    overflow:hidden;

    box-shadow:var(--shadow);

    text-align:center;

    padding-bottom:20px;

    transition:
        transform .3s,
        box-shadow .3s;

}

.product-card:hover{

    transform:translateY(-8px);

    box-shadow:
        0 12px 25px rgba(0,0,0,.18);

}

.product-card img{

    width:100%;

    aspect-ratio:4/3;

    object-fit:cover;

}

.product-card img{
    width:100%;
    height:240px;
    object-fit:cover;
}

.product-card h3{
    margin:18px 0 10px;
    color:#8B4513;
}

.product-card h4{
    margin-top:12px;
    color:#D2691E;
    font-size:1.2rem;
    font-weight:bold;
}

.product-card p{
    padding:0 18px;
}

/*==============================
GALLERY
==============================*/

.gallery{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(250px,1fr));
    gap:20px;
}

.gallery img{
    width:100%;
    height:220px;
    object-fit:cover;
    border-radius:12px;
    transition:.35s;
    box-shadow:0 4px 12px rgba(0,0,0,.15);
}

.gallery img:hover{
    transform:scale(1.05);
}

/*==============================
LISTS
==============================*/

ul,
ol{
    max-width:800px;
    margin:auto;
    padding-left:25px;
}

li{
    margin:10px 0;
}

/*==============================
TABLES
==============================*/

table{

    width:100%;

    border-collapse:collapse;

    overflow:hidden;

    border-radius:10px;

}

th{
    background:#8B4513;
    color:white;
    padding:14px;
}

td{
    border:1px solid #ddd;
    padding:14px;
    text-align:center;
}

tr:nth-child(even){
    background:#FFF1E6;
}

/*==============================
FORMS
==============================*/

form{
    max-width:700px;
    margin:auto;
    background:white;
    padding:35px;
    border-radius:15px;
    box-shadow:0 5px 15px rgba(0,0,0,.12);
}

label{
    display:block;
    margin-top:18px;
    font-weight:bold;
}

input,
select,
textarea{
    width:100%;
    padding:14px;
    margin-top:8px;
    border:1px solid #ccc;
    border-radius:8px;
    font-size:1rem;
}

input:focus,
select:focus,
textarea:focus{
    outline:none;
    border-color:#D2691E;
}

/*==============================
BLOCKQUOTE
==============================*/

blockquote{
    background:white;
    border-left:6px solid #D2691E;
    padding:20px;
    margin:25px auto;
    max-width:800px;
    font-style:italic;
    box-shadow:0 4px 10px rgba(0,0,0,.08);
}

/*==============================
IFRAMES
==============================*/

iframe{
    width:100%;
    border-radius:12px;
    margin-top:15px;
}

/*==============================
FOOTER
==============================*/

footer{

    background:#5C3317;

    color:white;

    text-align:center;

    padding:35px 20px;

    margin-top:80px;

}

footer a{

    color:white;

    text-decoration:none;

}

footer a:hover{

    text-decoration:underline;

}

/*==============================
ANIMATIONS
==============================*/

.product-card,
.gallery img,
section{
    animation:fadeIn .8s ease;
}

.hidden{

    opacity:0;

    transform:translateY(40px);

}

.show{

    opacity:1;

    transform:translateY(0);

    transition:.8s ease;

}

/*==============================
MOBILE MENU BUTTON
==============================*/

.nav-toggle{
    display:none;
}

/*==============================
RESPONSIVE DESIGN
==============================*/

@media(max-width:768px){

    header h1{
        font-size:2rem;
    }

    .hero{
        min-height:350px;
    }

    .hero h2{
        font-size:2rem;
    }

    nav{
        display:none;
        flex-direction:column;
        margin-top:20px;
    }

    nav.active{
        display:flex;
    }

    .nav-toggle{
        display:block;
        margin:15px auto;
        background:#D2691E;
        color:white;
        border:none;
        padding:12px 20px;
        border-radius:8px;
        cursor:pointer;
    }

    form{
        padding:20px;
    }

    table{
        display:block;
        overflow-x:auto;
    }

}

@media(max-width:480px){

    .hero-content{
        padding:25px;
    }

    .hero h2{
        font-size:1.6rem;
    }

    section h2{
        font-size:1.6rem;
    }

    .product-card img,
    .gallery img{
        height:180px;
    }

}

/*==============================
Accessibility
==============================*/

button:focus,
a:focus,
input:focus,
textarea:focus{

    outline:3px solid #FFD580;

    outline-offset:2px;

}

/*==============================
 Back to Top Button
==============================*/

#topButton{

    z-index:999;

}

#topButton:hover{

    background:var(--primary);

}

/*==============================
 Improve Mobile Navigation
==============================*/

nav{

    display:none;

    width:100%;

    flex-direction:column;

}

nav.active{

    display:flex;

}

nav a{

    width:100%;

    text-align:center;

}

/*==============================
 Reduced Motion
==============================*/

@media (prefers-reduced-motion:reduce){

    *{

        animation:none !important;

        transition:none !important;

        scroll-behavior:auto !important;

    }

}

